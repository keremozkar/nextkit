{
  "name": "frontendjoe-pattern-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43127",
    "build:kits": "npm run build --prefix kits-app",
    "build:next": "npm run build --prefix kits-next && rm -rf public/kits-next && cp -a kits-next/out public/kits-next",
    "build": "npm run build:kits && npm run build:next && tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43127",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
